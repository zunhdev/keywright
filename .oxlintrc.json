{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["app/ui/src/ipc/bindings.ts", "app/ui/src/test/sofle.ts"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn"
  },
  "rules": {
    "eslint/max-lines-per-function": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "import/max-dependencies": "off",
    // WebKit drops the list role of a list drawn without bullets, so VoiceOver doesn't say
    // "list, 3 items": those lists say role="list" again.
    "jsx-a11y/no-redundant-roles": ["error", { "ol": ["list"], "ul": ["list"] }],
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "**/no-performance-tracks.ts"] }
    ],
    "react/react-in-jsx-scope": "off",
    "typescript/no-confusing-void-expression": ["warn", { "ignoreArrowShorthand": true }],
    "typescript/prefer-readonly-parameter-types": "off"
  },
  "options": {
    "typeAware": true
  }
}
