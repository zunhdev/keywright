{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window's UI may use: following the session and the menus, changing keys and undoing changes, enabling and renaming its menu items, dragging the window by its toolbar, and opening System Settings and Keywright's docs. Each feature adds the commands and events it uses.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-session-state",
    "allow-session-keymap",
    "allow-key-catalog",
    "allow-dom-codes",
    "allow-shortcut-words",
    "allow-mac-actions",
    "allow-set-action",
    "allow-swap-keys",
    "allow-copy-key",
    "allow-copy-action",
    "allow-paste-action",
    "allow-set-keys",
    "allow-undo",
    "allow-redo",
    "allow-menu-set",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:*" },
        { "url": "https://github.com/zunhdev/keywright/blob/main/docs/user/*" }
      ]
    }
  ]
}
