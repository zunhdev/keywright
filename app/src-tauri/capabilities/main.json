{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window's UI may use: following the session and the menus, changing keys and undoing changes, enabling and renaming its menu items and editing text with them, dragging the window by its toolbar and starting it after the traffic lights, and opening System Settings and Keywright's docs. Each feature adds the commands and events it uses.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-session-state",
    "allow-battery-levels",
    "allow-bluetooth-permission",
    "allow-allow-bluetooth",
    "allow-open-bluetooth-settings",
    "allow-session-keymap",
    "allow-key-catalog",
    "allow-dom-codes",
    "allow-shortcut-words",
    "allow-mac-actions",
    "allow-set-action",
    "allow-swap-keys",
    "allow-copy-key",
    "allow-copy-action",
    "allow-paste-action",
    "allow-set-keys",
    "allow-undo",
    "allow-redo",
    "allow-menu-set",
    "allow-edit-text",
    "allow-layer-name-problem",
    "allow-rename-layer",
    "allow-move-layer",
    "allow-remove-layer",
    "allow-add-layer",
    "allow-keyboard-guide",
    "allow-start-demo",
    "allow-leave-demo",
    "allow-session-retry",
    "allow-keep-unsaved-changes",
    "allow-discard-unsaved-changes",
    "allow-reapply-changes",
    "allow-discard-changes",
    "allow-review-changes",
    "allow-revert-change",
    "allow-save-changes",
    "allow-quit-now",
    "allow-restore-stock-keys",
    "allow-restore-stock-layer",
    "allow-restore-stock-settings",
    "allow-traffic-lights",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:*" },
        { "url": "https://github.com/zunhdev/keywright/blob/main/docs/user/*" }
      ]
    }
  ]
}
