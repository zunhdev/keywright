{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keywright",
  "mainBinaryName": "Keywright",
  "identifier": "dev.zunh.keywright",
  "build": {
    "beforeDevCommand": "bun run --filter @keywright/ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run --filter @keywright/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keywright",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "copyright": "Copyright © 2026 Denis Rodionov",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    }
  }
}
